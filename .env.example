APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use `spaces` to store uploads on DigitalOcean Spaces instead.
VIDEO_ON_DEMAND_STORAGE_DISK=spaces
VIDEO_ON_DEMAND_STORAGE_DIRECTORY=videos
VIDEO_ON_DEMAND_UPLOAD_MAX_SIZE_KB=512000
VIDEO_ON_DEMAND_UPLOAD_PART_SIZE_MB=64
VIDEO_ON_DEMAND_UPLOAD_SESSION_LIFETIME_MINUTES=1440
VIDEO_ON_DEMAND_UPLOAD_PART_URL_LIFETIME_MINUTES=15
VIDEO_ON_DEMAND_UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm
VIDEO_ON_DEMAND_STREAM_ENDPOINT=
VIDEO_ON_DEMAND_STREAM_API_TOKEN=
VIDEO_ON_DEMAND_STREAM_PUBLIC_ENDPOINT=https://vod.example.test
VIDEO_ON_DEMAND_PLAYBACK_GRANT_SECRET=replace-with-a-shared-random-secret-at-least-32-characters
VIDEO_ON_DEMAND_PLAYBACK_GRANT_TTL_SECONDS=300
VIDEO_ON_DEMAND_STREAM_PROFILE=hls-standard
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_USE_PATH_STYLE_ENDPOINT=false
