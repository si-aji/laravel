APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Set FILESYSTEM_DISK=spaces to use DigitalOcean Spaces or another S3-compatible provider.
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_ENDPOINT=
DIGITALOCEAN_SPACES_REGION=
DIGITALOCEAN_SPACES_BUCKET=
DOS_DIR=

VIDEO_ON_DEMAND_TABLE_PREFIX=vod_
VIDEO_ON_DEMAND_TABLE_VIDEOS=vod_videos
VIDEO_ON_DEMAND_TABLE_UPLOADS=vod_uploads
# Multipart video uploads require an S3-compatible disk.
VIDEO_ON_DEMAND_STORAGE_DISK=spaces
VIDEO_ON_DEMAND_STORAGE_DIRECTORY=videos
VIDEO_ON_DEMAND_ORPHAN_CLEANUP_MIN_AGE_MINUTES=30
VIDEO_ON_DEMAND_UPLOAD_MAX_SIZE_KB=512000
VIDEO_ON_DEMAND_UPLOAD_PART_SIZE_MB=64
# Keep this equal to VIDEO_ON_DEMAND_UPLOAD_PART_SIZE_MB for pause/resume calculations in the browser.
VITE_VIDEO_UPLOAD_PART_SIZE_MB=64
VIDEO_ON_DEMAND_UPLOAD_SESSION_LIFETIME_MINUTES=1440
VIDEO_ON_DEMAND_UPLOAD_PART_URL_LIFETIME_MINUTES=15
VIDEO_ON_DEMAND_UPLOAD_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
